<?xml version="1.0"?>
<ruleset name="Complianz Terms &amp; Conditions">
	<description>Complianz T&amp;C rules for PHP_CodeSniffer (mirrors the main Complianz plugin).</description>

	<file>./</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>phpstan-bootstrap.php</exclude-pattern>

	<fileExtensions>
		<extension>php</extension>
	</fileExtensions>

	<arg value="sp"/>
	<arg name="report" value="full"/>
	<arg name="colors"/>
	<!-- Restrict to PHP: the <fileExtensions> element above is not honoured by
	     phpcs as a ruleset directive, so this arg is what actually limits the scan. -->
	<arg name="extensions" value="php"/>

	<config name="testVersion" value="7.4-8.4"/>

	<rule ref="WordPress"/>

	<rule ref="PHPCompatibility"/>
</ruleset>
