<?xml version="1.0"?>
<ruleset name="CMPLZ-TC-Security">
    <description>Complianz T&amp;C security rules for PHP_CodeSniffer (mirrors the main Complianz plugin).</description>

    <!-- Define the paths to be checked -->
    <file>./</file>

    <!-- Define the paths to be excluded -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- File extensions to check -->
    <fileExtensions>
        <extension>php</extension>
    </fileExtensions>
    <!-- Restrict to PHP: the <fileExtensions> element is not honoured by phpcs as
         a ruleset directive, so this arg is what actually limits the scan. -->
    <arg name="extensions" value="php"/>

    <!-- Security Rules -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.PluginMenuSlug"/>
    <rule ref="WordPress.Security.SafeRedirect"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
</ruleset>
